# ============================================================
# imap2webhook 配置文件模板
#
# 用法:
#   1. 把本文件复制为 .env(Windows 一键启动脚本会自动复制)
#   2. 把下面的 CHANGE_ME_* 占位符改成你的真实配置
#   3. 必填项标记为 ★
#
# 注意:
#   - 值里若包含空格或 # 等特殊字符,请用双引号包起来
#     例如:IMAP_PWD="pa ss#word"
#   - 邮箱密码通常是指"授权码"(QQ邮箱/163 等在设置里生成)
# ============================================================

# ---------- IMAP 账户(★ 全部带编号,从 1 开始)----------
# 账户名 = IMAP_USER(邮箱地址);监听多个邮箱时,把下面一组复制并把编号 +1。
# 编号必须连续:有 IMAP1_* 没 IMAP2_* 时,IMAP3_* 及之后的账户不会被加载。
IMAP1_HOST=CHANGE_ME_MAIL_SERVER       # IMAP 服务器地址,如 imap.qq.com
IMAP1_PORT=993                         # 端口,通常 993 (SSL)
IMAP1_USER=CHANGE_ME_YOUR_EMAIL        # 邮箱账号
IMAP1_PWD=CHANGE_ME_YOUR_PASSWORD      # 邮箱密码 / 授权码
IMAP1_SSL_VERIFY=true                  # 自建服务器用自签名证书时设为 false
IMAP1_TIMEOUT=30                       # 连接超时(秒)

# ---------- 多账户(可选)----------
# 需要监听第二个邮箱时,复制上面一组改成 IMAP2_* 前缀并填上账号密码。
# 未配置的项继承无前缀的全局默认值(IMAP_PORT/IMAP_TIMEOUT/MAILBOX/PAST_UNSEEN/ATTACH 等)。
# IMAP2_HOST=imap.qq.com
# IMAP2_PORT=993
# IMAP2_USER=xxx@qq.com
# IMAP2_PWD=xxx
# IMAP2_MAILBOX=INBOX
# IMAP2_SSL_VERIFY=true
# IMAP2_TIMEOUT=30
# IMAP2_PAST_UNSEEN=false
# IMAP2_ATTACH=true
# IMAP2_MAX_ATTACH_MB=10

# ---------- 推送通道:自定义脚本 ★ ----------
# 每封邮件都会把 JSON 通过 stdin 交给该脚本处理,由脚本决定推送到哪。
# (模板见 src/sender/custom_sender.py.example,复制到根目录后填路径)
CUSTOM_SENDER=CHANGE_ME_CUSTOM_SENDER_PATH   # 如 ./custom_sender.py(根目录)

# ---------- 可选 ----------
MAILBOX=INBOX                          # 要监听的文件夹
# ---------- 翻译 API(英文邮件自动翻译;不配 key = 不翻译)----------
# 服务商/模型/key 全部可自定义。OpenAI 兼容(默认,DeepSeek/OpenAI/硅基流动/Ollama/自建网关…):
#   TRANSLATE_API_TYPE=openai
#   TRANSLATE_API_URL=https://api.deepseek.com/chat/completions
#   TRANSLATE_API_MODEL=deepseek-chat
# 或 Anthropic(Claude):
#   TRANSLATE_API_TYPE=anthropic
#   TRANSLATE_API_URL=https://api.anthropic.com/v1/messages
#   TRANSLATE_API_MODEL=claude-sonnet-5
TRANSLATE_API_KEY=
PAST_UNSEEN=false                      # true = 首次启动把已有未读邮件全部转发
ATTACH=true                            # false = 不发送附件
MAX_ATTACH_MB=10                       # 附件大小上限(MB),超过的跳过
PUSH_RETRIES=3                         # 推送失败重试次数(2s/4s/8s 退避)
LOG_LEVEL=INFO                         # DEBUG / INFO / WARNING / ERROR
FLUSH_DB=false                         # true = 启动时清空已处理记录(只开一次,之后改回 false)

# ---------- 数据库 ----------
# SQLite 数据库文件位置(start.bat 会自动创建 data/ 目录)
DB_PATH=./data/data.db
