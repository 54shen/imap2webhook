# ============================================================
# imap2webhook 配置文件模板
#
# 用法:
#   1. 把本文件复制为 .env(Windows 一键启动脚本会自动复制)
#   2. 把下面的 CHANGE_ME_* 占位符改成你的真实配置
#   3. 必填项标记为 ★
#
# 注意:
#   - 值里若包含空格或 # 等特殊字符,请用双引号包起来
#     例如:IMAP_PWD="pa ss#word"
#   - 邮箱密码通常是指"授权码"(QQ邮箱/163 等在设置里生成)
# ============================================================

# ---------- IMAP 服务器 ★ ----------
# 账户 0(无前缀)始终存在;监听多个邮箱时,把下面的组复制一份并把编号 +1
IMAP_HOST=CHANGE_ME_MAIL_SERVER        # IMAP 服务器地址,如 imap.qq.com
IMAP_PORT=993                          # 端口,通常 993 (SSL)
IMAP_USER=CHANGE_ME_YOUR_EMAIL         # 邮箱账号
IMAP_PWD=CHANGE_ME_YOUR_PASSWORD       # 邮箱密码 / 授权码
IMAP_SSL_VERIFY=true                   # 自建服务器用自签名证书时设为 false
IMAP_TIMEOUT=30                        # 连接超时(秒)

# ---------- 多账户(可选)----------
# 需要监听第二个邮箱时,把下面一组复制、编号 +1(IMAP1_*、IMAP2_*...)。
# 编号必须连续:有 IMAP1_* 没 IMAP2_* 时,IMAP3_* 之后的账户不会被加载。
# 未配置的项继承全局默认值(端口/超时/MAILBOX/PAST_UNSEEN/ATTACH 等)。
# IMAP1_HOST=imap.qq.com
# IMAP1_PORT=993
# IMAP1_USER=xxx@qq.com
# IMAP1_PWD=xxx
# IMAP1_MAILBOX=INBOX
# IMAP1_SSL_VERIFY=true
# IMAP1_TIMEOUT=30
# IMAP1_PAST_UNSEEN=false
# IMAP1_ATTACH=true
# IMAP1_MAX_ATTACH_MB=10

# ---------- 推送通道:自定义脚本 ★ ----------
# 每封邮件都会把 JSON 通过 stdin 交给该脚本处理,由脚本决定推送到哪。
# (模板见 src/sender/custom_sender.py.example,复制到根目录后填路径)
CUSTOM_SENDER=CHANGE_ME_CUSTOM_SENDER_PATH   # 如 ./custom_sender.py(根目录)

# ---------- 可选 ----------
MAILBOX=INBOX                          # 要监听的文件夹
DEEPSEEK_API_KEY=                      # 英文邮件自动翻译成中文(留空 = 不翻译,其他功能不受影响)
PAST_UNSEEN=false                      # true = 首次启动把已有未读邮件全部转发
ATTACH=true                            # false = 不发送附件
MAX_ATTACH_MB=10                       # 附件大小上限(MB),超过的跳过
PUSH_RETRIES=3                         # 推送失败重试次数(2s/4s/8s 退避)
LOG_LEVEL=INFO                         # DEBUG / INFO / WARNING / ERROR
FLUSH_DB=false                         # true = 启动时清空已处理记录(只开一次,之后改回 false)

# ---------- 数据库 ----------
# SQLite 数据库文件位置(start.bat 会自动创建 data/ 目录)
DB_PATH=./data/data.db
